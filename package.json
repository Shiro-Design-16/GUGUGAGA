    "type": "git",
    "url": "git+https://github.com/Shiro-Design-16/GUGUGAGA.git"
  },
  "bugs": {
    "url": "https://github.com/Shiro-Design-16/GUGUGAGA/issues"
  },
  "keywords": [
    "gugugaga",
    "esolang",
    "programming-language",
